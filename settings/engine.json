{
  "properties": {
    "engine.downloadUrl": {
      "type": "string",
      "title": "引擎下载地址",
      "group": "Engine",
      "default": ""
    },
    "engine.autoDownload": {
      "type": "boolean",
      "title": "首次使用时下载引擎",
      "group": "Engine",
      "default": true
    },
    "engine.degradePolicy": {
      "type": "string",
      "title": "引擎不可用时的处理",
      "group": "Engine",
      "enum": [
        "text-only",
        "prompt"
      ],
      "default": "text-only"
    },
    "engine.startupTimeoutMs": {
      "type": "integer",
      "title": "引擎启动超时（毫秒）",
      "group": "Engine",
      "default": 5000
    },
    "engine.requestTimeoutMs": {
      "type": "integer",
      "title": "引擎请求超时（毫秒）",
      "group": "Engine",
      "default": 30000
    },
    "engine.javaPath": {
      "type": "string",
      "title": "Java 可执行文件",
      "group": "Engine",
      "default": ""
    },
    "engine.maxRestarts": {
      "type": "integer",
      "title": "降级前的引擎重启次数",
      "group": "Engine",
      "default": 3
    }
  }
}