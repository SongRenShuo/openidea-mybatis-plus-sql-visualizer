{
  "properties": {
    "dialect.mode": {
      "type": "string",
      "title": "Dialect mode",
      "group": "Dialect",
      "enum": ["auto", "manual"],
      "default": "auto"
    },
    "dialect.default": {
      "type": "string",
      "title": "Default dialect",
      "group": "Dialect",
      "enum": [
        "MySQL",
        "PostgreSQL",
        "Oracle",
        "SQL Server",
        "H2",
        "SQLite",
        "MariaDB",
        "DM（达梦）",
        "KingBase（人大金仓）",
        "OceanBase",
        "openGauss",
        "GaussDB",
        "HighGo",
        "Vastbase",
        "GoldenDB"
      ],
      "default": "MySQL"
    },
    "dialect.detectFromUrl": {
      "type": "boolean",
      "title": "Detect dialect from the JDBC URL",
      "group": "Dialect",
      "default": true
    },
    "dialect.autoDetectFromMappers": {
      "type": "boolean",
      "title": "Detect dialect from mapper statements",
      "group": "Dialect",
      "default": true
    },
    "dialect.quoteIdentifiers": {
      "type": "string",
      "title": "Quote identifiers",
      "group": "Dialect",
      "enum": ["auto", "always", "never"],
      "default": "auto"
    },
    "dialect.keywordCase": {
      "type": "string",
      "title": "Keyword case",
      "group": "Dialect",
      "enum": ["auto", "upper", "lower"],
      "default": "auto"
    },
    "log.prefix": {
      "type": "string",
      "title": "Log prefix",
      "group": "Log",
      "default": ""
    },
    "log.slowThresholdMs": {
      "type": "integer",
      "title": "Slow statement threshold (ms)",
      "group": "Log",
      "default": 1000
    },
    "log.nPlusOneThreshold": {
      "type": "integer",
      "title": "N+1 threshold",
      "group": "Log",
      "default": 5
    },
    "log.dedupe": {
      "type": "boolean",
      "title": "Fold duplicate statements",
      "group": "Log",
      "default": true
    },
    "log.dedupeWindowMs": {
      "type": "integer",
      "title": "Duplicate window (ms)",
      "group": "Log",
      "default": 0
    },
    "log.ignoreParamsInDedupe": {
      "type": "boolean",
      "title": "Ignore parameter values when deduplicating",
      "group": "Log",
      "default": false
    },
    "log.maxSqlLength": {
      "type": "integer",
      "title": "Maximum SQL length",
      "group": "Log",
      "default": 20000
    },
    "log.refreshIntervalMs": {
      "type": "integer",
      "title": "Refresh interval (ms)",
      "group": "Log",
      "default": 250
    },
    "log.timestampOffsetMinutes": {
      "type": "integer",
      "title": "Timestamp offset (minutes east of UTC)",
      "group": "Log",
      "default": 0
    },
    "log.showRawLine": {
      "type": "boolean",
      "title": "Show raw line for partial statements",
      "group": "Log",
      "default": true
    },
    "render.paramsSeparator": {
      "type": "string",
      "title": "Parameter separator",
      "group": "Rendering",
      "default": ", "
    },
    "render.sqlCase": {
      "type": "string",
      "title": "Rendered SQL case",
      "group": "Rendering",
      "enum": ["preserve", "upper", "lower"],
      "default": "preserve"
    },
    "render.dateFormat": {
      "type": "string",
      "title": "Date format",
      "group": "Rendering",
      "default": "yyyy-MM-dd HH:mm:ss"
    },
    "render.showConfidence": {
      "type": "boolean",
      "title": "Show confidence",
      "group": "Rendering",
      "default": true
    },
    "render.formatSql": {
      "type": "boolean",
      "title": "Format SQL",
      "group": "Rendering",
      "default": true
    },
    "render.indentWidth": {
      "type": "integer",
      "title": "Indent width",
      "group": "Rendering",
      "default": 2
    },
    "render.truncateSql": {
      "type": "integer",
      "title": "Preview truncation (characters)",
      "group": "Rendering",
      "default": 180
    },
    "render.exportFormat": {
      "type": "string",
      "title": "Export format",
      "group": "Rendering",
      "enum": ["sql", "json"],
      "default": "sql"
    },
    "nav.enabled": {
      "type": "boolean",
      "title": "Mapper and XML navigation",
      "group": "Navigation",
      "default": false
    },
    "nav.showLineMarkers": {
      "type": "boolean",
      "title": "Gutter line markers",
      "group": "Navigation",
      "default": true
    },
    "injections.enabled": {
      "type": "boolean",
      "title": "SQL injection in mapper XML",
      "group": "Navigation",
      "default": false
    },
    "injections.language": {
      "type": "string",
      "title": "Injection language id",
      "group": "Navigation",
      "default": "sql"
    },
    "inlay.enabled": {
      "type": "boolean",
      "title": "Inlay hints",
      "group": "Navigation",
      "default": false
    },
    "inlay.insertColumns": {
      "type": "boolean",
      "title": "Show INSERT target columns",
      "group": "Navigation",
      "default": true
    },
    "diagnostics.enabled": {
      "type": "boolean",
      "title": "Diagnostics",
      "group": "Navigation",
      "default": false
    },
    "diagnostics.unknownColumn": {
      "type": "boolean",
      "title": "Report unknown columns",
      "group": "Navigation",
      "default": true
    },
    "diagnostics.dialectQuotes": {
      "type": "boolean",
      "title": "Report dialect quote mismatches",
      "group": "Navigation",
      "default": true
    },
    "engine.downloadUrl": {
      "type": "string",
      "title": "Engine download URL",
      "group": "Engine",
      "default": ""
    },
    "engine.autoDownload": {
      "type": "boolean",
      "title": "Download the engine on first use",
      "group": "Engine",
      "default": true
    },
    "engine.degradePolicy": {
      "type": "string",
      "title": "When the engine is unavailable",
      "group": "Engine",
      "enum": ["text-only", "prompt"],
      "default": "text-only"
    },
    "engine.startupTimeoutMs": {
      "type": "integer",
      "title": "Engine startup timeout (ms)",
      "group": "Engine",
      "default": 5000
    },
    "engine.requestTimeoutMs": {
      "type": "integer",
      "title": "Engine request timeout (ms)",
      "group": "Engine",
      "default": 30000
    },
    "engine.javaPath": {
      "type": "string",
      "title": "Java executable",
      "group": "Engine",
      "default": ""
    },
    "engine.maxRestarts": {
      "type": "integer",
      "title": "Engine restarts before degrading",
      "group": "Engine",
      "default": 3
    }
  }
}