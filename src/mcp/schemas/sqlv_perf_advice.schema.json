{
  "title": "sqlv_perf_advice",
  "type": "object",
  "description": "Run performance rules, a 0-100 complexity score and index advice on each SQL statement of the text.",
  "additionalProperties": false,
  "properties": {
    "sql": {
      "type": "string",
      "description": "SQL text; top-level semicolons separate statements, and each statement is analysed on its own.",
      "minLength": 1
    },
    "dialect": {
      "type": "string",
      "description": "Dialect name used by the quote-mismatch rule.",
      "enum": [
        "mysql",
        "postgresql",
        "oracle",
        "sqlserver",
        "h2",
        "sqlite",
        "mariadb",
        "dm",
        "kingbase",
        "oceanbase",
        "opengauss",
        "gaussdb",
        "highgo",
        "vastbase",
        "goldendb"
      ]
    },
    "indexes": {
      "type": "array",
      "description": "Existing indexes, so advice can avoid duplicating them.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table": {
            "type": "string",
            "description": "Table the index belongs to."
          },
          "name": {
            "type": "string",
            "description": "Index name."
          },
          "columns": {
            "type": "array",
            "description": "Index columns in order.",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "unique": {
            "type": "boolean",
            "description": "Whether the index is unique."
          }
        },
        "required": ["table", "name", "columns"]
      }
    }
  },
  "required": ["sql"]
}